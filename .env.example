# =============================================================================
# LMS Platform - Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Django Core
# ---------------------------------------------------------------------------
SECRET_KEY=your-very-long-random-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development
TIME_ZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQL repository mode (current platform default). The whole application is not
# yet migrated to MongoDB; see ARCHITECTURE.md before selecting it in the pilot.
DATABASE_ENGINE=sql
DB_NAME=myportal
DB_USER=postgres
DB_PASSWORD=replace-with-local-postgres-password
DB_HOST=localhost
DB_PORT=5432
# DATABASE_URL takes precedence when set (for example, in Docker/production).
# For PostgreSQL (production):
# DATABASE_URL=postgresql://lms_user:password@localhost:5432/lms_db
# For Docker:
# DATABASE_URL=postgresql://lms_user:password@postgres:5432/lms_db
# DATABASE_URL=sqlite:///db.sqlite3
# Optional: run the test suite against PostgreSQL instead of in-memory SQLite.
# TEST_DATABASE_URL=postgresql://lms_user:password@localhost:5432/lms_db

# MongoDB repository pilot (not yet a whole-platform database mode).
MONGO_URI=mongodb://localhost:27017
# Docker service URI; localhost above is for running Django directly on Windows.
MONGO_URI_DOCKER=mongodb://mongodb:27017
MONGO_DB_NAME=myportal
# Set true before the enrollment snapshot import to capture concurrent SQL writes
# in the durable outbox. Keep enabled after switching DATABASE_ENGINE=mongodb.
MONGO_ENROLLMENT_SYNC_ENABLED=False
# Set true before the notification snapshot to capture concurrent SQL changes.
MONGO_NOTIFICATION_SYNC_ENABLED=False
MONGO_ACCOUNT_SYNC_ENABLED=False
# Set true before the published course catalog snapshot to capture concurrent SQL edits.
MONGO_COURSE_CATALOG_SYNC_ENABLED=False

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Email (SMTP)
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=LMS Platform <noreply@yourdomain.com>
SUPPORT_EMAIL=support@yourdomain.com

# ---------------------------------------------------------------------------
# Object Storage
# ---------------------------------------------------------------------------
# Options: local | minio | s3 | azure | gdrive
STORAGE_BACKEND=local

# MinIO (local development)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=replace-with-local-minio-password
S3_BUCKET_NAME=lms-content
S3_REGION=us-east-1
S3_SIGNED_URL_EXPIRY=3600

# For AWS S3:
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
# S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# S3_BUCKET_NAME=my-lms-bucket
# S3_REGION=ap-south-1

# For Azure Blob Storage:
# STORAGE_BACKEND=azure
# AZURE_ACCOUNT_NAME=your_storage_account_name
# AZURE_ACCOUNT_KEY=your_storage_account_key
# AZURE_CONTAINER=lms-content
# AZURE_CONNECTION_STRING=
# AZURE_CUSTOM_DOMAIN=
# AZURE_SIGNED_URL_EXPIRY=3600

# For Google Drive:
# STORAGE_BACKEND=gdrive
# GDRIVE_ROOT_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz   # Drive folder ID (from URL)
# GDRIVE_SHARED_DRIVE_ID=                              # Optional: Shared Drive ID
# GDRIVE_SIGNED_URL_EXPIRY=3600
#
# Authentication — choose ONE of the following:
# Option A: path to a service-account key JSON file
# GDRIVE_SERVICE_ACCOUNT_JSON=/run/secrets/gdrive_sa.json
# Option B: raw JSON string (for Docker / CI secrets)
# GDRIVE_SERVICE_ACCOUNT_INFO={"type":"service_account","project_id":"...", ...}
# Option C: Application Default Credentials (run `gcloud auth application-default login`)
#   — no extra variables needed

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=razorpay

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Platform
# ---------------------------------------------------------------------------
PLATFORM_NAME=EduFlow
PLATFORM_URL=http://localhost:8000

# Portal palette defaults (used until Common → Platform Settings is saved).
# Once saved, the admin settings record is the runtime source of truth.
PORTAL_PRIMARY_COLOR=#6366F1
PORTAL_ACCENT_COLOR=#A78BFA
PORTAL_BACKGROUND_COLOR=#0B1120
PORTAL_SURFACE_COLOR=#111827
PORTAL_RAISED_SURFACE_COLOR=#1E293B
PORTAL_TEXT_COLOR=#F8FAFC
PORTAL_MUTED_TEXT_COLOR=#94A3B8
PORTAL_BORDER_COLOR=#334155
PORTAL_INVERSE_TEXT_COLOR=#FFFFFF
PORTAL_SUCCESS_COLOR=#22C55E
PORTAL_WARNING_COLOR=#F59E0B
PORTAL_ERROR_COLOR=#EF4444
PORTAL_INFO_COLOR=#38BDF8
PORTAL_INVOICE_BACKGROUND_COLOR=#FFFFFF
PORTAL_INVOICE_SURFACE_COLOR=#F8FAFC
PORTAL_INVOICE_TEXT_COLOR=#0F172A
PORTAL_INVOICE_MUTED_TEXT_COLOR=#64748B
PORTAL_INVOICE_BORDER_COLOR=#E2E8F0


# ---------------------------------------------------------------------------
# Security (production values)
# ---------------------------------------------------------------------------
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
DB_SSL_REQUIRE=False

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
LECTURE_COMPLETION_THRESHOLD=90
TAX_RATE=0.18
TAX_ENABLED=True
MAX_VIDEO_SIZE_MB=2048
MAX_DOCUMENT_SIZE_MB=50
MAX_IMAGE_SIZE_MB=10
RATELIMIT_ENABLE=True
LOGIN_RATE_LIMIT=5/m

# ---------------------------------------------------------------------------
# MinIO (Docker)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-local-minio-password

# ---------------------------------------------------------------------------
# PostgreSQL (Docker)
# ---------------------------------------------------------------------------
POSTGRES_DB=lms_db
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=replace-with-local-postgres-password

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
